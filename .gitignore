# AI skill packages (Claude/Cursor skill format)
*.skill
*-skill/
*-skill-unpacked/

# Repo preflight / context artifacts (repomix, aider map, llm prompts)
.ai-context/
.repomix/
repomix-output.*
aider.repo-map.txt
llm-prompt.md

# Timestamped pre-edit backups (incl. ai-gitignore skill's own .gitignore backups)
*._MOD_backup.*

# Terraform / OpenTofu local state, plans and overrides
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# IDE / editor
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temp / scratch / local backups
tmp/
*.tmp
*.bak

# Python tool caches
__pycache__/
*.pyc
*.pyo
.ruff_cache/
.mypy_cache/
.pytest_cache/
