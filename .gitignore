# Timestamped copies left by install.sh and by anyone editing a live file.
# Recoverable from history by definition, and untracked they hide the one thing
# `git status` is for — a change nobody meant to make.
*.bak.*

# Paths that belong to this machine, read by release.sh — a mirror of the skill
# that install.sh does not write to. Never in a public repository.
.release.local

# Findings from a cold review (`review-YYYY-MM-DD-<object>.md`, written by the
# audit skill). A work order, true on its date and meaningless once the items
# land; what it produced belongs in CHANGELOG.md and in kb/.
review-*.md

# Session memory written by the assistant tooling.
.memsearch/

# kb/ — the assistant's work notes, of the same nature as CLAUDE.md and
# AGENTS.md: local to this machine, not part of the published skill.
kb/

# >>> ai-gitignore managed block (edit via ai-gitignore skill, not here) >>>
